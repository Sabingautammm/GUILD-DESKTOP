# ============ GUILD Frontend Environment ============
# Copy to `.env` and adjust. `.env` is gitignored.

# Where the API lives. Leave EMPTY to use the Vite dev proxy
# (dev: /api -> http://localhost:5000 via vite.config.js).
# For a production build, point to your deployed API:
# VITE_API_URL=https://api.yourdomain.com/api
VITE_API_URL=

# Google OAuth 2.0 Client ID (must match the backend GOOGLE_CLIENT_ID).
# Leave EMPTY to use the dev-only mock Google button (works with
# NODE_ENV=development on the backend). When set, the real Google
# Identity Services sign-in is used.
# VITE_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=